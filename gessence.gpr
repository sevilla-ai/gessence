--  Native (x86-64) build. WebAssembly lives in gessence_wasm.gpr.

project GEssence is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("hello.adb");

   Style_Switches :=
     ("-gnaty3",    --  3 space indentation
      "-gnatya",    --  attribute casing
      "-gnatyb",    --  no trailing blanks
      "-gnatyc",    --  comment format
      "-gnatye",    --  end/exit labels
      "-gnatyf",    --  no form feeds or vertical tabs
      "-gnatyh",    --  no horizontal tabs
      "-gnatyi",    --  if-then layout
      "-gnatyk",    --  keyword casing
      "-gnatyl",    --  reference manual layout
      "-gnatyM99",  --  maximum line length
      "-gnatyn",    --  casing of Standard identifiers
      "-gnatyp",    --  pragma casing
      "-gnatyr",    --  identifier casing must match declaration
      "-gnatyS",    --  no statement following then/else on the same line
      "-gnatyt");   --  token separation rules

   package Compiler is
      for Switches ("Ada") use
        ("-gnat2022",
         "-gnatwa",   --  all optional warnings
         "-gnatVa")   --  all validity checks
        & Style_Switches;
   end Compiler;

   package Builder is
      for Switches ("Ada") use ("-j0");
   end Builder;

end GEssence;
