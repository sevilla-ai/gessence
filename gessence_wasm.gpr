--  WebAssembly build (AdaWebPack + GNAT-LLVM).
--
--  gessence_wasm.adb is the main that pulls in GEssence_Exports, which is what
--  produces the "water" and "is_prime" exports index.html calls. Building only
--  hello_wasm.adb leaves those symbols out of the module entirely.

with "/usr/lib/gnat/adawebpack.gpr";
with "/usr/lib/gnat/adawebpack_config.gpr";

project GEssence_Wasm is

   --  src holds the portable resolver, wasm holds the browser-only bindings.
   for Source_Dirs use ("src", "wasm");
   for Excluded_Source_Files use ("hello.adb");
   for Object_Dir use "obj-wasm";
   for Exec_Dir use ".";
   for Main use ("gessence_wasm.adb", "hello_wasm.adb");

   package Compiler is
      for Driver ("Ada") use "llvm-gnat1";
      for Switches ("Ada") use
        ("-x", "ada",
         "-gnatA",
         "--target=wasm32",
         "-O1",
         "-gnatp",
         "-gnatpn");
   end Compiler;

   package Binder is
      for Driver ("Ada") use "llvm-gnatbind";
      for Switches ("Ada") use ("-n");
   end Binder;

   package Linker is
      for Driver use "llvm-gnatlink";
      for Switches ("Ada") use ("-L/usr/lib/adawebpack");
   end Linker;

end GEssence_Wasm;
